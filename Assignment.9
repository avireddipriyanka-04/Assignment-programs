#include <stdio.h>
#include <ctype.h>

int main() {
    char ch;
    printf("Enter a character: ");
    scanf(" %c", &ch);

    // Convert to lowercase to handle both cases easily
    char lowerCh = tolower(ch);

    if (lowerCh == 'a' || lowerCh == 'e' || lowerCh == 'i' || lowerCh == 'o' || lowerCh == 'u') {
        printf("'%c' is a vowel.\n", ch);
    } else {
        printf("'%c' is not a vowel.\n", ch);
    }

    return 0;
}
